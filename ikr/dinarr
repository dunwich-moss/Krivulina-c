#include <stdio.h>
#include <stdlib.h>

struct Book
{
    char name[50];
    char author[50];
    int year;
    int cena;
};

int main(){
    int *arr;
    int n;
    scanf("%d", &n);
    struct Book* library = (struct Book*)malloc(n * sizeof(struct Book*));

    for(int i=0; i<n; i++){
        sprintf(library[i].name, library[i].author, library[i].year, library[i].cena, "%s %s %d %d");;
    }
    for (int j =0; j<n; j++){
        printf("Name:%s Author:%s Year:%d Cena:%d",library[j].name, library[j].author, library[j].year, library[j].cena );
    }
}
